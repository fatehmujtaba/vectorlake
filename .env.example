VECTORLAKE_ENVIRONMENT=local
VECTORLAKE_LOG_LEVEL=INFO
VECTORLAKE_SERVICE_NAME=vectorlake-api
# Set this when an OpenTelemetry collector is available.
VECTORLAKE_OTLP_ENDPOINT=

# Local emulator values only. Do not reuse these credentials outside Floci.
VECTORLAKE_LOCAL_AWS_ENDPOINT_URL=http://127.0.0.1:4566
VECTORLAKE_LOCAL_AWS_REGION=us-east-1
VECTORLAKE_LOCAL_AWS_ACCESS_KEY_ID=test
VECTORLAKE_LOCAL_AWS_SECRET_ACCESS_KEY=test
VECTORLAKE_LOCAL_POSTGRES_USERNAME=vectorlake
VECTORLAKE_LOCAL_POSTGRES_PASSWORD=vectorlake-local-only
VECTORLAKE_LOCAL_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
